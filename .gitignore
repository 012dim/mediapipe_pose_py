# ===== Python 标准模板 =====
# 字节码 / 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 发行 / 打包
build/
dist/
*.egg-info/
*.egg
.eggs/

# 虚拟环境
venv/
.venv/
.venv312/
env/
ENV/

# 本项目本地产生的目录
.matplotlib_cache/
wheels/

# 临时诊断/测试脚本
_test_*.py
_run_main.py

# 环境变量
.env
.env.local
*.env

# 测试 / 覆盖率
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 项目特定
screenshots/*.png
!screenshots/.gitkeep
models/*
!models/.gitkeep

# 本地 junction 链接说明(可选,不影响代码运行)
mpvlink.txt

# 日志
*.log
logs/
